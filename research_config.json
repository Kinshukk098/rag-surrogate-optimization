
{
  "surrogate_experiment": {
    "random_seed": 42,
    "training_budgets": [20, 40, 60, 80, 100, 150, 200, 250, 320],
    "test_split": "test",
    "training_split": "train",
    "validation": {
      "method": "kfold",
      "n_splits": 5,
      "shuffle": true,
      "random_seed": 42
    },
    "targets": {
      "mean_answer_f1": "max",
      "mean_answer_em": "max",
      "mean_latency": "min",
      "mean_total_tokens": "min"
    },
    "ranking": {
      "actual_top_k": 5,
      "predicted_top_k": 10
    },
    "models": {
      "linear_regression": {},
      "polynomial_regression": {
        "degree": 2,
        "alpha": 1.0
      },
      "random_forest": {
        "n_estimators": 300,
        "max_features": 1.0,
        "min_samples_leaf": 2
      },
      "rbf_network": {
        "n_centers": 20,
        "alpha": 1.0
      },
      "gaussian_process": {
        "n_restarts_optimizer": 2
      }
    },
    "search": {
      "evaluation_budget": 20,
      "candidate_pool_size": 1000,
      "selection_counts": [1, 5],
      "methods": [
        "random_search",
        "lhs",
        "surrogate_guided"
      ]
    },
    "repeated_runs": {
      "enabled": true,
      "n_repeats": 5
    }
  },
  "datasets": {
    "hotpotqa": {
      "questions_path": "data/splits/hotpotqa_100_questions.json",
      "corpus_path": "data/processed/hotpotqa_100_corpus.json",
      "enabled": true
    },
    "scifact": {
      "questions_path": "data/splits/scifact_100_questions.json",
      "corpus_path": "data/processed/scifact_corpus.json",
      "enabled": false
    }
  },
  "configuration_files": {
    "train": "data/configurations/selected_balanced_v2/train_configs_320.json",
    "test": "data/configurations/selected_balanced_v2/test_configs_80.json"
  },
  "llm": {
    "model": "qwen2.5:3b",
    "temperature": 0,
    "max_completion_tokens": 256,
    "seed": 42
  },
  "experiment": {
    "experiment_id": "rag_surrogate_v2",
    "random_seed": 42,
    "question_limit": null,
    "retrieval_k": 20,
    "max_retries": 3,
    "retry_delay_seconds": 5,
    "checkpoint_every_question": true
  },
  "outputs": {
    "directory": "data/processed/experiments",
    "hotpotqa_results": "data/processed/experiments/hotpotqa_question_results_final_v2.csv",
    "scifact_results": "data/processed/experiments/scifact_question_results_v2.csv",
    "failed_runs": "data/processed/experiments/failed_runs_final_v2.csv"
  }
